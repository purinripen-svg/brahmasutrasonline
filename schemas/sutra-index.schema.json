{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrahmaSutrasOnline Sutra Index",
  "type": "object",
  "required": [
    "schemaVersion",
    "totalSutras",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "totalSutras": {
      "type": "integer",
      "minimum": 1,
      "maximum": 555
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "sutra-index-record.schema.json"
      }
    }
  },
  "additionalProperties": false
}
